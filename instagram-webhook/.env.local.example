# ──────────────────────────────────────────────────────────
# 사복노트 인스타그램 DM 봇 — 환경변수 설정
# 이 파일을 복사해서 .env.local 로 저장하고 값을 채우세요
# cp .env.local.example .env.local
#
# Vercel 배포 시: 프로젝트 Settings → Environment Variables 에 동일하게 입력
# ──────────────────────────────────────────────────────────

# ① 내가 직접 정한 비밀 토큰 (아무 문자열이나 OK, 예: sabok_secret_2024)
# Meta 개발자 콘솔 웹훅 등록 시 "Verify Token" 필드에 동일한 값 입력
VERIFY_TOKEN=sabok_secret_여기에원하는값입력

# ② Meta 개발자 콘솔 → 앱 → Instagram → API 설정 → Page Access Token
# (instagram_manage_messages 권한 포함 필요)
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxx

# ③ 사복노트 인스타그램 비즈니스 계정 ID (숫자만)
# 확인 방법: GET https://graph.facebook.com/me?fields=id,name&access_token={META_ACCESS_TOKEN}
IG_ACCOUNT_ID=17841400000000000
