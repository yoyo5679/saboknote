# ──────────────────────────────────────────────
# 사복노트 환경변수 설정
# 이 파일을 복사해서 .env 로 저장하고 값을 채우세요
# cp .env.example .env
# ──────────────────────────────────────────────

# [필수] Anthropic API 키 — cardmaker_agent.py 실행에 필요
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── 인스타그램 자동 업로드 (instagram_post.py) ──

# [필수] Cloudinary — 이미지 공개 URL 호스팅
# https://cloudinary.com/console → Cloud name / API Key / API Secret
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# [필수] Instagram Graph API
# 1. https://developers.facebook.com 에서 앱 생성
# 2. Instagram Basic Display 또는 Instagram Graph API 추가
# 3. instagram_basic + instagram_content_publish 권한 요청
# 4. 비즈니스 계정 연동 후 Long-lived User Access Token 발급 (60일 유효)
INSTAGRAM_ACCESS_TOKEN=EAAxxxxxxxxxx...

# Instagram 비즈니스 계정 ID
# 발급 방법: GET https://graph.facebook.com/me/accounts?access_token=TOKEN
#             → 페이지 ID로 instagram_business_account 조회
INSTAGRAM_USER_ID=17841400000000000
